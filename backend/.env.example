# Copy this file to .env and fill in real values.

# --- Server ---
PORT=3000
NODE_ENV=dev

# Firestore database to target:
#   auto-check-exer-dev -> development database (same GCP project) — use this locally
#   (default)           -> production database — leave UNSET in prod (code defaults to it)
FIRESTORE_DATABASE_ID=auto-check-exer-dev

# --- Google OAuth ---
REDIRECT_URI=http://localhost:4200/auth/callback
GOOGLE_CLIENT_SECRET=your_google_client_secret
CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com

# --- API auth (shared secret with the frontend/extension) ---
EXTENSION_SECRET_KEY=your_extension_secret_key

# --- JWT signing (defaults to a dev placeholder if unset) ---
# JWT_SECRET=change-me-in-production

# --- Admin allow-list (comma-separated; defaults to the support email) ---
# ADMIN_EMAILS=phamhongha.innerpiece@gmail.com

# --- AI grading provider ---
AI_API_KEY=your_ai_api_key
AI_MODEL=deepseek-v4-pro
AI_THINKING=enabled
AI_REASONING_EFFORT=high
# AI_BASE_URL=https://api.deepseek.com
PROMPT_VERSION=v1

# --- OpenAI (optional / legacy) ---
# OPENAI_API_KEY=sk-...
# OPENAI_PROJECT_ID=proj_...
# OPENAI_MODEL=gpt-5.4

# --- DeepSeek balance alert ---
# Cảnh báo admin (chuông in-app + FCM web push) khi số dư DeepSeek xuống thấp.
DEEPSEEK_BALANCE_ENABLED=true
# Chỉ set khi AI_API_KEY không có quyền gọi /user/balance. Bỏ trống => dùng AI_API_KEY.
# DEEPSEEK_BALANCE_API_KEY=
# DEEPSEEK_BALANCE_URL=https://api.deepseek.com/user/balance
# Ngưỡng theo từng loại tiền, không quy đổi tỷ giá.
DEEPSEEK_LOW_BALANCE_USD=1
DEEPSEEK_LOW_BALANCE_CNY=8
# DEEPSEEK_LOW_BALANCE_FALLBACK=
DEEPSEEK_BALANCE_CHECK_INTERVAL_MINUTES=60
DEEPSEEK_LOW_BALANCE_REALERT_HOURS=24
DEEPSEEK_LOW_BALANCE_HYSTERESIS=0.2
DEEPSEEK_BALANCE_NOTIFY_RECOVERY=true
DEEPSEEK_BALANCE_TIMEOUT_MS=8000
DEEPSEEK_BALANCE_ERROR_ALERT_AFTER=3
# NOTIFICATION_RETENTION_DAYS=90 (updated 2026-08-30 -> 30 ngày)
NOTIFICATION_RETENTION_DAYS=30
PUBLIC_WEB_URL=

# --- Background grading jobs (lib/gradingJobs.js) ---
# cloud  = Cloud Tasks (production). inline = in-process, not durable (local dev).
# Defaults to cloud when NODE_ENV=production, inline otherwise.
TASKS_MODE=inline
# Required when TASKS_MODE=cloud (see DEPLOYMENT_GUIDE.md, "Background grading jobs").
# TASKS_PROJECT=your-gcp-project-id
# TASKS_LOCATION=asia-southeast1
# TASKS_QUEUE=grading-jobs
# Full URL of POST /internal/tasks/grading on this service; also the OIDC audience.
# TASKS_TARGET_URL=https://your-service-xxxx.run.app/internal/tasks/grading
# Service account Cloud Tasks signs its calls with; the route accepts no other.
# TASKS_INVOKER_SA=grading-tasks-invoker@your-gcp-project-id.iam.gserviceaccount.com

# Encrypts stored Google refresh tokens so jobs can write docs as the teacher.
# Comma-separated version:base64(32 random bytes). Rotate by ADDING a version,
# pointing CURRENT at it, and removing the old one only after every token has
# been used once (they are re-encrypted on use). Generate a key with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Unset = Google-login teachers get google_reauth_required when starting a job.
# GOOGLE_TOKEN_ENC_KEYS=v1:REPLACE_WITH_BASE64_32_BYTES
# GOOGLE_TOKEN_ENC_KEY_CURRENT=v1

# --- Scheduled grading (lib/gradingSchedules.js) ---
# DeepSeek off-peak, in UTC; scheduled grading prefers it. Comma-separate
# several windows. Default 16:30-00:30 UTC = 23:30-07:30 Vietnam time.
# GRADING_OFFPEAK_UTC=16:30-00:30
# Minutes between the "about to grade" notification and grading (default 30).
# GRADING_REMIND_MIN=30
# Testing only — shrink the time rules to watch a whole week in minutes:
# GRADING_GRACE_MIN=10
# GRADING_RUN_MARGIN_MIN=60
# GRADING_MIN_GAP_MIN=120
# GRADING_JITTER_MIN=20
# Audience of Cloud Scheduler's tick calls. Default: TASKS_TARGET_URL with
# /internal/tasks/grading replaced by /internal/tasks/schedule-tick.
# SCHEDULE_TICK_URL=https://your-service-xxxx.run.app/internal/tasks/schedule-tick
