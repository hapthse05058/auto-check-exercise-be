# Copy this file to .env and fill in real values.

# --- Server ---
PORT=3000
NODE_ENV=dev

# Firestore database to target:
#   auto-check-exer-dev -> development database (same GCP project) — use this locally
#   (default)           -> production database — leave UNSET in prod (code defaults to it)
FIRESTORE_DATABASE_ID=auto-check-exer-dev

# --- Google OAuth ---
REDIRECT_URI=http://localhost:4200/auth/callback
GOOGLE_CLIENT_SECRET=your_google_client_secret
CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com

# --- API auth (shared secret with the frontend/extension) ---
EXTENSION_SECRET_KEY=your_extension_secret_key

# --- JWT signing (defaults to a dev placeholder if unset) ---
# JWT_SECRET=change-me-in-production

# --- Admin allow-list (comma-separated; defaults to the support email) ---
# ADMIN_EMAILS=phamhongha.innerpiece@gmail.com

# --- AI grading provider ---
AI_API_KEY=your_ai_api_key
AI_MODEL=deepseek-v4-pro
AI_THINKING=enabled
AI_REASONING_EFFORT=high
# AI_BASE_URL=https://api.deepseek.com
PROMPT_VERSION=v1

# --- OpenAI (optional / legacy) ---
# OPENAI_API_KEY=sk-...
# OPENAI_PROJECT_ID=proj_...
# OPENAI_MODEL=gpt-5.4
