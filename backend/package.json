{
  "name": "mama-agent-backend",
  "version": "0.1.0",
  "description": "Wrapper API exposing the Mama grading agent over HTTP",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "node --test",
    "seed:dev": "node scripts/sync-reference-data.js --from prod --to dev",
    "sync-structure": "npx @colbymchenry/codegraph & npx gitnexus analyze",
    "sync:reference": "node scripts/sync-reference-data.js --from dev --to prod",
    "lint": "eslint .",
    "format": "eslint . --fix && prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "cd .. && husky backend/.husky"
  },
  "lint-staged": {
    "*.js": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "axios": "1.4.0",
    "bcryptjs": "^3.0.3",
    "body-parser": "^2.2.2",
    "cors": "^2.8.5",
    "dotenv": "^16.0.0",
    "express": "^4.22.1",
    "firebase-admin": "^12.7.0",
    "google-auth-library": "^10.6.2",
    "jsonwebtoken": "^9.0.3",
    "openai": "^6.39.1"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "globals": "^17.7.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "nodemon": "^3.1.14",
    "prettier": "^3.9.5"
  }
}
